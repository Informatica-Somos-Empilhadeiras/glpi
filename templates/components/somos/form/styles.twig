<style>
/* ============================================================
   SOMOS EMPILHADEIRAS
   FORM UI
   ============================================================ */

.somos-form {
    background:
        radial-gradient(
            circle at 85% 5%,
            rgba(144, 235, 84, 0.10),
            transparent 22rem
        ),
        linear-gradient(
            180deg,
            #f7faf8 0%,
            #f0f0f0 100%
        );
}

.somos-form__renderer {
    width: min(100%, 960px) !important;
    margin-inline: auto !important;

    padding: 2rem 0 4.5rem;

    color: #141414;
}


/* ============================================================
   HEADER
   ============================================================ */

.somos-form__renderer
[data-glpi-form-renderer-form-header] {
    position: relative;

    margin-bottom: 1.75rem !important;
    padding: 2.4rem 2.6rem;

    overflow: hidden;

    background: #ffffff;

    border: 1px solid rgba(0, 102, 59, 0.09);
    border-radius: 22px;

    box-shadow:
        0 18px 45px rgba(20, 20, 20, 0.055),
        0 3px 10px rgba(20, 20, 20, 0.025);
}

.somos-form__renderer
[data-glpi-form-renderer-form-header]::before {
    content: "";

    position: absolute;
    top: 0;
    left: 0;

    width: 110px;
    height: 6px;

    background:
        linear-gradient(
            90deg,
            #00663B 0%,
            #00663B 58%,
            #90EB54 58%,
            #90EB54 100%
        );

    border-radius: 0 0 8px 0;
}

.somos-form__renderer
[data-glpi-form-renderer-form-header]::after {
    content: "";

    position: absolute;

    width: 210px;
    height: 210px;

    top: -125px;
    right: -90px;

    border: 42px solid rgba(144, 235, 84, 0.08);
    border-radius: 50%;

    pointer-events: none;
}

.somos-form__renderer .form-title {
    position: relative;
    z-index: 1;

    margin: 0 0 0.7rem !important;

    color: #00663B;

    font-size: clamp(1.9rem, 3vw, 2.45rem);
    font-weight: 750;
    line-height: 1.08;
    letter-spacing: -0.025em;
}

.somos-form__renderer .form-description {
    position: relative;
    z-index: 1;

    max-width: 760px;

    margin: 0;

    color: #68736d;

    font-size: 0.96rem;
    line-height: 1.7;
}


/* ============================================================
   SEÇÕES
   ============================================================ */

.somos-form__renderer
[data-glpi-form-renderer-section] {
    margin-bottom: 1.5rem;
}

.somos-form__renderer
[data-glpi-form-renderer-section]
> .bg-primary {
    position: relative;

    display: flex;
    align-items: center;

    min-height: 46px;

    padding: 0.75rem 1rem !important;

    background:
        linear-gradient(
            135deg,
            #00663B 0%,
            #005a34 65%,
            #00532f 100%
        ) !important;

    color: #ffffff !important;

    border: 0 !important;
    border-radius: 12px 12px 0 0 !important;

    box-shadow:
        0 6px 15px rgba(0, 102, 59, 0.10);
}

.somos-form__renderer
[data-glpi-form-renderer-section]
> .bg-primary::before {
    content: "";

    width: 7px;
    height: 24px;

    margin-right: 0.65rem;

    background: #90EB54;

    border-radius: 999px;
}

.somos-form__renderer
[data-glpi-form-renderer-section]
> .bg-primary h2 {
    margin: 0;

    color: #ffffff !important;

    font-size: 0.93rem;
    font-weight: 700;
    letter-spacing: 0.01em;
}

.somos-form__renderer
[data-glpi-form-renderer-section]
> .card {
    margin-bottom: 0 !important;

    background: rgba(255, 255, 255, 0.98);

    border: 1px solid rgba(0, 102, 59, 0.08);

    border-top: 0;

    border-radius: 0 0 14px 14px;

    box-shadow:
        0 12px 28px rgba(20, 20, 20, 0.045);
}

.somos-form__renderer
[data-glpi-form-renderer-section]
> .card
> .card-body {
    padding: 1.75rem;
}


/* ============================================================
   DESCRIÇÃO DA SEÇÃO
   ============================================================ */

.somos-form__renderer .section-description {
    margin-bottom: 1.5rem !important;

    padding: 0.85rem 1rem;

    background: #f6f9f7;

    border-left: 3px solid #90EB54;
    border-radius: 0 8px 8px 0;

    color: #6f7873;

    font-size: 0.84rem;
    line-height: 1.55;
}


/* ============================================================
   PERGUNTAS
   ============================================================ */

.somos-form__renderer
[data-glpi-form-renderer-question] {
    padding: 0.25rem 0 1.55rem;
}

.somos-form__renderer
[data-glpi-form-renderer-question]
> h3 {
    display: flex;
    align-items: center;
    gap: 0.45rem;

    margin: 0 0 0.55rem !important;

    color: #18201c;

    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
}

.somos-form__renderer
[data-glpi-form-renderer-question]
> h3::before {
    content: "";

    width: 4px;
    height: 18px;

    flex: 0 0 auto;

    background: #90EB54;

    border-radius: 999px;
}

.somos-form__renderer
[data-glpi-form-renderer-question]
> h3
.text-danger {
    color: #00663B !important;

    font-weight: 800;
}

.somos-form__renderer .block-description {
    margin: 0 0 0.8rem !important;

    color: #7b847f;

    font-size: 0.82rem;
    line-height: 1.55;
}


/* ============================================================
   INPUTS
   ============================================================ */

.somos-form__renderer
input.form-control,
.somos-form__renderer
textarea.form-control,
.somos-form__renderer
select.form-select {
    width: 100%;

    min-height: 50px;

    padding: 0.82rem 0.95rem;

    background: #ffffff !important;

    border: 1px solid #cbd5cf !important;
    border-radius: 12px !important;

    color: #141414 !important;

    font-size: 0.94rem;
    line-height: 1.45;

    box-shadow:
        inset 0 1px 1px rgba(20, 20, 20, 0.02),
        0 1px 2px rgba(20, 20, 20, 0.025);

    transition:
        border-color 150ms ease,
        box-shadow 150ms ease,
        background-color 150ms ease,
        transform 150ms ease;
}

.somos-form__renderer
textarea.form-control {
    min-height: 160px;

    resize: vertical;
    line-height: 1.6;
}


/* Placeholder */

.somos-form__renderer
input.form-control::placeholder,
.somos-form__renderer
textarea.form-control::placeholder {
    color: #a2aba6;

    opacity: 1;

    font-size: 0.9rem;
    font-weight: 400;
}


/* Hover */

.somos-form__renderer
input.form-control:hover,
.somos-form__renderer
textarea.form-control:hover,
.somos-form__renderer
select.form-select:hover {
    background: #fcfdfc !important;

    border-color: #aebbb4 !important;
}


/* Focus */

.somos-form__renderer
input.form-control:focus,
.somos-form__renderer
textarea.form-control:focus,
.somos-form__renderer
select.form-select:focus {
    background: #ffffff !important;

    border-color: #00663B !important;

    outline: none !important;

    box-shadow:
        0 0 0 3px rgba(144, 235, 84, 0.17),
        0 8px 18px rgba(0, 102, 59, 0.06) !important;

    transform: translateY(-1px);
}


/* ============================================================
   SELECT2
   ============================================================ */

.somos-form__renderer
.select2-container {
    width: 100% !important;
}

.somos-form__renderer
.select2-container
.select2-selection--single,
.somos-form__renderer
.select2-container
.select2-selection--multiple {
    min-height: 50px;

    background: #ffffff !important;

    border: 1px solid #cbd5cf !important;
    border-radius: 12px !important;

    box-shadow:
        inset 0 1px 1px rgba(20, 20, 20, 0.02);

    transition:
        border-color 150ms ease,
        box-shadow 150ms ease;
}

.somos-form__renderer
.select2-container
.select2-selection--single {
    height: 50px;
}

.somos-form__renderer
.select2-container
.select2-selection--single
.select2-selection__rendered {
    line-height: 48px;

    padding-left: 0.95rem;

    color: #141414;
}

.somos-form__renderer
.select2-container
.select2-selection--multiple {
    padding: 0.45rem 0.5rem;
}

.somos-form__renderer
.select2-container.select2-container--open
.select2-selection--single,
.somos-form__renderer
.select2-container.select2-container--focus
.select2-selection--single,
.somos-form__renderer
.select2-container.select2-container--open
.select2-selection--multiple,
.somos-form__renderer
.select2-container.select2-container--focus
.select2-selection--multiple {
    border-color: #00663B !important;

    box-shadow:
        0 0 0 3px rgba(144, 235, 84, 0.17),
        0 8px 18px rgba(0, 102, 59, 0.05) !important;
}

.somos-form__renderer
.select2-dropdown {
    margin-top: 5px;

    overflow: hidden;

    background: #ffffff;

    border: 1px solid #cbd5cf !important;
    border-radius: 12px !important;

    box-shadow:
        0 18px 36px rgba(20, 20, 20, 0.12);
}

.somos-form__renderer
.select2-results__option {
    padding: 0.72rem 0.9rem;

    transition:
        background-color 120ms ease;
}

.somos-form__renderer
.select2-results__option--highlighted {
    background: #00663B !important;

    color: #ffffff;
}

.somos-form__renderer
.select2-results__option[aria-selected="true"] {
    background: rgba(144, 235, 84, 0.16);

    color: #141414;
}

.somos-form__renderer
.select2-search__field {
    min-height: 38px;

    padding: 0.5rem 0.7rem !important;

    background: #ffffff !important;

    border: 1px solid #d0d9d4 !important;
    border-radius: 9px !important;

    color: #141414;
}

.somos-form__renderer
.select2-search__field::placeholder {
    color: #a2aba6;
}


/* ============================================================
   CHECKBOX / RADIO
   ============================================================ */

.somos-form__renderer
.form-check {
    padding: 0.7rem 0.8rem;

    background: #fbfcfb;

    border: 1px solid #dde4df;
    border-radius: 10px;

    transition:
        border-color 140ms ease,
        background-color 140ms ease,
        transform 140ms ease;
}

.somos-form__renderer
.form-check:hover {
    background: rgba(144, 235, 84, 0.07);

    border-color: #bdcbc3;

    transform: translateY(-1px);
}

.somos-form__renderer
.form-check-input {
    border-color: #b9c5be;

    box-shadow: none;
}

.somos-form__renderer
.form-check-input:checked {
    background-color: #00663B !important;
    border-color: #00663B !important;
}

.somos-form__renderer
.form-check-input:focus {
    border-color: #00663B;

    box-shadow:
        0 0 0 3px rgba(144, 235, 84, 0.17);
}


/* ============================================================
   UPLOAD DE ARQUIVO
   ============================================================ */

.somos-form__renderer
input[type="file"].form-control {
    min-height: 54px;

    padding: 0.75rem 0.9rem;

    background:
        linear-gradient(
            180deg,
            #ffffff 0%,
            #f9fcfa 100%
        ) !important;

    border: 1px dashed #aabbb1 !important;
    border-radius: 12px !important;

    color: #59655f;

    cursor: pointer;
}

.somos-form__renderer
input[type="file"].form-control:hover {
    background: rgba(144, 235, 84, 0.06) !important;

    border-color: #00663B !important;
}


/* ============================================================
   TINYMCE
   ============================================================ */

.somos-form__renderer
.tox-tinymce {
    overflow: hidden;

    background: #ffffff;

    border: 1px solid #cbd5cf !important;
    border-radius: 12px !important;

    box-shadow:
        inset 0 1px 1px rgba(20, 20, 20, 0.02);
}

.somos-form__renderer
.tox-tinymce:focus-within {
    border-color: #00663B !important;

    box-shadow:
        0 0 0 3px rgba(144, 235, 84, 0.17),
        0 8px 18px rgba(0, 102, 59, 0.05) !important;
}

.somos-form__renderer
.tox
.tox-toolbar,
.somos-form__renderer
.tox
.tox-toolbar__primary,
.somos-form__renderer
.tox
.tox-toolbar__overflow {
    background: #f5f9f6 !important;
}


/* ============================================================
   BOTÕES
   ============================================================ */

.somos-form__renderer
[data-glpi-form-renderer-actions] {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 0.75rem;

    margin-top: 2rem;
}

.somos-form__renderer
[data-glpi-form-renderer-actions]
.btn-primary {
    min-height: 50px;

    padding: 0.75rem 1.4rem;

    background:
        linear-gradient(
            135deg,
            #00663B 0%,
            #00542f 100%
        ) !important;

    border: 1px solid #00663B !important;
    border-radius: 12px !important;

    color: #ffffff !important;

    font-size: 0.9rem;
    font-weight: 700;

    box-shadow:
        0 8px 18px rgba(0, 102, 59, 0.15);

    transition:
        transform 150ms ease,
        box-shadow 150ms ease,
        background 150ms ease;
}

.somos-form__renderer
[data-glpi-form-renderer-actions]
.btn-primary:hover {
    background: #90EB54 !important;

    border-color: #90EB54 !important;

    color: #141414 !important;

    transform: translateY(-1px);

    box-shadow:
        0 10px 22px rgba(0, 102, 59, 0.12);
}

.somos-form__renderer
[data-glpi-form-renderer-actions]
.btn-ghost-secondary {
    min-height: 50px;

    padding: 0.75rem 1.2rem;

    border-radius: 12px;
}


/* ============================================================
   SUCESSO
   ============================================================ */

.somos-form__renderer
[data-glpi-form-renderer-success] {
    padding: 2.4rem;

    background: #ffffff;

    border: 1px solid rgba(0, 102, 59, 0.08);
    border-radius: 18px;

    box-shadow:
        0 14px 34px rgba(20, 20, 20, 0.06);
}

.somos-form__renderer
[data-glpi-form-renderer-success]
.empty-title {
    color: #00663B;
}


/* ============================================================
   RESPONSIVO
   ============================================================ */

@media (max-width: 767.98px) {

    .somos-form__renderer {
        width: 100% !important;

        padding: 1rem 0 3rem;
    }

    .somos-form__renderer
    [data-glpi-form-renderer-form-header] {
        padding: 1.6rem;

        border-radius: 16px;
    }

    .somos-form__renderer
    [data-glpi-form-renderer-section]
    > .card
    > .card-body {
        padding: 1.1rem;
    }

    .somos-form__renderer
    [data-glpi-form-renderer-actions] {
        flex-direction: column-reverse;
        align-items: stretch;
    }

    .somos-form__renderer
    [data-glpi-form-renderer-actions]
    .btn-primary,
    .somos-form__renderer
    [data-glpi-form-renderer-actions]
    .btn-ghost-secondary {
        width: 100%;
    }
}
</style>