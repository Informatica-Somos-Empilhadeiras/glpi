{% extends "layout/page_skeleton.html.twig" %}

{% set scene_left = entity.getHelpdeskSceneId('custom_helpdesk_home_scene_left') %}
{% set scene_right = entity.getHelpdeskSceneId('custom_helpdesk_home_scene_right') %}

{% block content %}

    <div class="somos-helpdesk-home">

        {% include "pages/helpdesk/_somos_home_hero.html.twig" with {
            entity: entity
        } only %}

        {% include "pages/helpdesk/_somos_quick_access.html.twig" with {
            tiles: tiles
        } only %}

        <section class="somos-helpdesk-tickets">
            <div class="container-xl">
                {{ tabs.showTabsContent() }}
            </div>
        </section>

    </div>

    <script>
        (async function() {
            const module = await import(
                "/js/modules/Helpdesk/IndexController.js"
            );

            new module.GlpiHelpdeskIndexController();
        })();
    </script>

{% endblock content %}
