<style>
/* ------------------------------------------------------------
   SESSÃO QUICK ACCESS E CARDS
   ------------------------------------------------------------ */
.somos-quick-access {
    padding: 0 0 5rem;
    background: #F0F0F0;

    /* Força o preenchimento cinza na tela toda (100vw) */
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
}

.somos-quick-access__grid {
    width: min(100%, 980px);
    margin: -70px auto 0;
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
}

/* ------------------------------------------------------------
   CARD (Sem bordas, com sombra evidente)
   ------------------------------------------------------------ */
.somos-helpdesk-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.5rem 2rem 1.5rem;
    background: #FFFFFF;
    border-radius: 16px;
    border: none;
    color: #141414;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    transition: transform 250ms ease, box-shadow 250ms ease;
    height: 100%;
}

.somos-helpdesk-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 102, 59, 0.15);
}

/* ------------------------------------------------------------
   ÍCONE (Abstração Orgânica / Sustentabilidade)
   ------------------------------------------------------------ */
.somos-helpdesk-card__icon {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 90px;
    height: 90px;
    margin-bottom: 1.5rem;

    background: rgba(144, 235, 84, 0.22);
    border-radius: 43% 57% 65% 35% / 46% 45% 55% 54%;
    transition: transform 300ms ease, border-radius 300ms ease;
}

.somos-helpdesk-card__icon::before {
    content: "";
    position: absolute;
    inset: -4px 6px 4px -6px;
    z-index: -1;

    background: rgba(0, 102, 59, 0.06);
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    transition: transform 300ms ease, border-radius 300ms ease;
}

.somos-helpdesk-card:hover .somos-helpdesk-card__icon {
    transform: translateY(-3px);
    border-radius: 50% 50% 34% 66% / 56% 68% 32% 44%;
}

.somos-helpdesk-card:hover .somos-helpdesk-card__icon::before {
    transform: rotate(15deg) scale(1.05);
    border-radius: 40% 60% 70% 30% / 45% 55% 45% 55%;
}

/* ------------------------------------------------------------
   TEXTOS E CALL TO ACTION (CTA)
   ------------------------------------------------------------ */
.somos-helpdesk-card__title {
    margin: 0 0 0.85rem;
    color: #141414;
    font-size: 1.15rem;
    font-weight: 700;
}

.somos-helpdesk-card__description {
    width: 100%;
    color: #666666;
    font-size: 0.9rem;
    line-height: 1.6;
}

.somos-helpdesk-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.5rem;
    color: #00663B;
    font-size: 0.9rem;
    font-weight: 700;
    transition: color 200ms ease, transform 200ms ease;
}

.somos-helpdesk-card:hover .somos-helpdesk-card__cta {
    color: #004424;
}

.somos-helpdesk-card:hover .somos-helpdesk-card__cta span {
    transform: translateX(4px);
    transition: transform 200ms ease;
}

@media (max-width: 991.98px) {
    .somos-quick-access__grid {
        width: min(100%, 700px);
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 575.98px) {
    .somos-quick-access {
        padding: 0 1rem 3.5rem;
    }

    .somos-quick-access__grid {
        grid-template-columns: 1fr;
        margin-top: -40px;
    }
}
</style>

<section
    class="somos-quick-access"
    aria-label="{{ __("Quick Access") }}"
    data-testid="somos-quick-access"
>
    <div class="somos-quick-access__grid">

        {% for tile in tiles %}

            {% set show_tile = false %}

            {#
             * TODOS os formulários configurados como cards
             * na Home do Helpdesk serão exibidos.
             *
             * Antes estávamos limitando aos IDs [1, 2].
             * Isso impedia novos formulários de aparecerem.
             #}
            {% if tile is instanceof('Glpi\\Helpdesk\\Tile\\FormTile') %}

                {% set show_tile = true %}

            {#
             * Meus chamados
             #}
            {% elseif tile is instanceof('Glpi\\Helpdesk\\Tile\\GlpiPageTile') %}

                {% if tile.getPage() == 'tickets' %}
                    {% set show_tile = true %}
                {% endif %}

            {% endif %}

            {% if show_tile %}
                {% include "pages/helpdesk/_somos_quick_card.html.twig" with {
                    tile: tile
                } only %}
            {% endif %}

        {% endfor %}

    </div>
</section>