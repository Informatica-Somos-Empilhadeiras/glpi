{
    "name": "GLPI Somos Dev",
    "dockerComposeFile": "../docker-compose.dev.yaml",
    "service": "glpi",
    "workspaceFolder": "/var/www/glpi",

    "forwardPorts": [8091],

    "portsAttributes": {
        "8091": {
            "label": "GLPI Dev",
            "onAutoForward": "openBrowser"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "Vue.volar",
                "xdebug.php-debug",
                "mblode.twig-language-2",
                "dbaeumer.vscode-eslint"
            ]
        }
    }
}
